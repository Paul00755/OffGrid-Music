rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(sessionId) {
      return signedIn() && exists(/databases/$(database)/documents/jamSessions/$(sessionId)/participants/$(request.auth.uid));
    }
    function host(sessionId) {
      return member(sessionId)
        && get(/databases/$(database)/documents/jamSessions/$(sessionId)).data.hostUid == request.auth.uid;
    }
    function joiningJam(sessionId) {
      let participant = getAfter(/databases/$(database)/documents/jamSessions/$(sessionId)/participants/$(request.auth.uid)).data;
      let session = get(/databases/$(database)/documents/jamSessions/$(sessionId)).data;
      let invitation = get(/databases/$(database)/documents/jamInvitations/$(participant.invitationHash)).data;
      return signedIn()
        && !exists(/databases/$(database)/documents/jamSessions/$(sessionId)/participants/$(request.auth.uid))
        && session.status == 'ACTIVE'
        && session.get('started', false) != true
        && session.participantCount < session.maxParticipants
        && participant.invitationHash is string
        && invitation.sessionId == sessionId
        && invitation.active == true
        && invitation.expiresAt > request.time;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /{subcollection=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Spark-compatible Jam state. Membership is required for reads and session subcollections.
    // Host controls are limited to host-owned documents; clients never write audio bytes here.
    match /jamSessions/{sessionId} {
      // Session IDs are random and are obtained from an invitation. Signed-in invitees need
      // to read active session metadata before the transaction can decide whether to join.
      allow get: if member(sessionId) || (signedIn() && resource.data.status == 'ACTIVE');
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.participantCount == 1
        && request.resource.data.maxParticipants is int
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.maxParticipants <= 10
        && request.resource.data.get('started', false) == false;
      allow update: if (member(sessionId) || joiningJam(sessionId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'hostUid', 'participantCount', 'permissions', 'playback', 'revision', 'queueRevision', 'started'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['started']) ||
          (host(sessionId)
            && resource.data.get('started', false) != true
            && request.resource.data.started == true
            && resource.data.participantCount >= 2))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['playback'])
          || resource.data.get('started', true) == true)
        && (!joiningJam(sessionId) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'revision'])
            && request.resource.data.participantCount <= resource.data.maxParticipants));
      allow delete: if false;

      match /participants/{participantUid} {
        allow read: if member(sessionId);
        allow create: if signedIn() && participantUid == request.auth.uid && (
          (getAfter(/databases/$(database)/documents/jamSessions/$(sessionId)).data.hostUid == request.auth.uid
            && request.resource.data.role == 'HOST')
          || joiningJam(sessionId)
        );
        allow update: if member(sessionId) && (participantUid == request.auth.uid || host(sessionId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoUrl', 'lastSeenAt', 'role']);
        allow delete: if member(sessionId) && participantUid == request.auth.uid;
      }

      match /queue/{queueItemId} {
        allow read: if member(sessionId);
        allow create, update: if member(sessionId)
          && request.resource.data.keys().hasOnly(['track', 'position', 'addedByUid', 'addedAt', 'source']);
        allow delete: if member(sessionId);
      }

      match /recommendations/{recommendationId} {
        allow read: if member(sessionId);
        allow create: if member(sessionId)
          && request.resource.data.proposerUid == request.auth.uid
          && request.resource.data.recommendationType in ['LOCAL_SONG', 'SHARED_LIBRARY']
          && request.resource.data.eligibleUids.size() <= 10;
        allow update: if member(sessionId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'votes', 'approvalCount', 'rejectionCount', 'status', 'downloads', 'checksum', 'fileSize',
            'contentType', 'uploadProgress', 'uploadStatus', 'failureReason', 'transferExpiresAt'
          ]);
        allow delete: if false;
      }

      match /peerTransfers/{transferId} {
        allow read: if member(sessionId)
          && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
        allow create: if member(sessionId)
          && request.resource.data.senderUid == request.auth.uid
          && exists(/databases/$(database)/documents/jamSessions/$(sessionId)/participants/$(request.resource.data.recipientUid))
          && request.resource.data.fileSize > 0 && request.resource.data.fileSize <= 26214400
          && request.resource.data.keys().hasOnly([
            'recommendationId', 'senderUid', 'recipientUid', 'mimeType', 'fileSize', 'sha256', 'offerSdp', 'status', 'createdAtMs'
          ]);
        allow update: if member(sessionId)
          && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerSdp', 'status', 'completedAtMs']);
        allow delete: if member(sessionId)
          && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      }

      match /commands/{commandId} {
        allow read: if member(sessionId);
        allow create: if member(sessionId) && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /jamInvitations/{inviteHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/jamSessions/$(request.resource.data.sessionId)).data.hostUid == request.auth.uid
        && request.resource.data.active == true;
      allow update: if signedIn()
        && get(/databases/$(database)/documents/jamSessions/$(resource.data.sessionId)).data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
