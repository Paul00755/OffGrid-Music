<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Minimal Stream Geometric Audio Wave Crests -->
    <path
        android:pathData="M28,68 L28,40 L44,28 L44,80 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#33FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="44"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF7C4DFF" />
                <item android:offset="1.0" android:color="#FF536DFE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Stream Prism Blade -->
    <path
        android:pathData="M44,28 L64,44 L64,64 L44,80 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#66FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="28"
                android:endX="64"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFB388FF" />
                <item android:offset="0.5" android:color="#FF8C9EFF" />
                <item android:offset="1.0" android:color="#FF651FFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Forward Flow Stream Fin -->
    <path
        android:pathData="M64,44 L80,54 L80,58 L64,64 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#33FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="64"
                android:startY="44"
                android:endX="80"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00E5FF" />
                <item android:offset="1.0" android:color="#FF7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sharp Play & Stream Impulse Lines -->
    <path
        android:pathData="M38,44 L38,64"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <path
        android:pathData="M52,38 L52,70"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#FFFFFF" />

    <path
        android:pathData="M58,45 L58,63"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeColor="#E0E7FF" />

    <path
        android:pathData="M72,50 L72,58"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF" />

</vector>
