<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include database and settings; exclude only sensitive private API keys -->
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="file" path="backups" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="gemini_user_key.dat" />
        <exclude domain="file" path="gemini_user_key.fallback" />
    </cloud-backup>
    <device-transfer>
        <!-- Include database and settings for seamless upgrades and device transfers -->
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="file" path="backups" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="gemini_user_key.dat" />
        <exclude domain="file" path="gemini_user_key.fallback" />
    </device-transfer>
</data-extraction-rules>
