<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Exclude personal device-local API keys and account data from Android Cloud Backup -->
    <exclude domain="file" path="gemini_user_key.dat" />
    <exclude domain="file" path="gemini_user_key.fallback" />
    <exclude domain="sharedpref" path="user_settings.preferences_pb" />
    <exclude domain="database" path="offgrid_music_db" />
    <exclude domain="database" path="offgrid_music_db-wal" />
    <exclude domain="database" path="offgrid_music_db-shm" />
</full-backup-content>
