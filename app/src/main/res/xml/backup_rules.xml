<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Include database and settings; exclude sensitive private API keys -->
    <include domain="database" path="." />
    <include domain="file" path="datastore" />
    <include domain="file" path="backups" />
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="gemini_user_key.dat" />
    <exclude domain="file" path="gemini_user_key.fallback" />
</full-backup-content>
