<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamically rendered dark harmonized rounded card background -->
    <ImageView
        android:id="@+id/widget_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Content column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <!-- Top rounded artwork -->
        <ImageView
            android:id="@+id/widget_card_artwork"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:scaleType="centerCrop"
            android:contentDescription="Album Artwork" />

        <!-- Timestamp (3:04 / 4:56) -->
        <TextView
            android:id="@+id/widget_card_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="0:00 / 0:00"
            android:textColor="#E8D0D8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false" />

        <!-- Song Title (Accent Color) -->
        <TextView
            android:id="@+id/widget_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="OffGrid Music"
            android:textColor="#FF4B72"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Subtitle (Artist • Album) -->
        <TextView
            android:id="@+id/widget_card_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Offline Audio"
            android:textColor="#B8A2AC"
            android:textSize="12sp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Circular Playback Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp">

            <!-- Previous Button -->
            <ImageView
                android:id="@+id/widget_card_btn_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerInside"
                android:contentDescription="Previous Track" />

            <!-- Play / Pause Button -->
            <ImageView
                android:id="@+id/widget_card_btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerInside"
                android:contentDescription="Play or Pause" />

            <!-- Next Button -->
            <ImageView
                android:id="@+id/widget_card_btn_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerInside"
                android:contentDescription="Next Track" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
