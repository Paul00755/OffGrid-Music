<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dark themed rounded card background -->
    <ImageView
        android:id="@+id/widget_medium_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <!-- Left inset rounded-square artwork (dynamically sized per widget width so horizontal resize never clips controls) -->
        <ImageView
            android:id="@+id/widget_medium_artwork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:contentDescription="Album Artwork" />

        <!-- Right column: Metadata + Favorite, Progress Bar, Timestamps, Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:gravity="center_vertical">

            <!-- Top Row: Title/Artist + Favorite Heart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <LinearLayout
                    android:id="@+id/widget_medium_header_click"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_medium_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OffGrid Music"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_medium_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Offline Audio"
                        android:textColor="#9AA2B1"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_medium_btn_favorite"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Favorite Track" />
            </LinearLayout>

            <!-- Straight Progress Bar (tapping opens Now Playing screen) -->
            <ImageView
                android:id="@+id/widget_medium_progress"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitCenter"
                android:contentDescription="Playback Progress" />

            <!-- Timestamps row (left current / right total) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_medium_time_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#8D95A5"
                    android:textSize="10sp"
                    android:gravity="start"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_medium_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#8D95A5"
                    android:textSize="10sp"
                    android:gravity="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Bottom Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <ImageView
                    android:id="@+id/widget_medium_btn_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_medium_btn_play_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_medium_btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Next Track" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
