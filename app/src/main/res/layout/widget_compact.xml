<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="10dp">

    <!-- Blurred / Vignette Background Overlay -->
    <ImageView
        android:id="@+id/widget_compact_bg_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35" />

    <!-- Content Row: Artwork, Title/Subtitle/Artist, Heart -->
    <LinearLayout
        android:id="@+id/widget_compact_content_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_compact_artwork"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track Title"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_compact_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Album"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/widget_compact_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_compact_btn_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="Favorite" />
    </LinearLayout>

    <!-- Progress Bar Row with Seek Targets -->
    <LinearLayout
        android:id="@+id/widget_compact_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_compact_content_row"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_compact_time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="2dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0:00"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/widget_compact_progress_container"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">

            <ProgressBar
                android:id="@+id/widget_compact_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_progress_drawable"
                android:max="100"
                android:progress="0" />

            <ImageView
                android:id="@+id/widget_compact_waveform_progress"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:contentDescription="Waveform Seek Bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_compact_seek_backward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek Backward"
                    android:src="@android:color/transparent" />

                <ImageView
                    android:id="@+id/widget_compact_seek_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek Forward"
                    android:src="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/widget_compact_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="0:00"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Controls Row: Proportioned 3-button layout -->
    <LinearLayout
        android:id="@+id/widget_compact_controls_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/widget_compact_progress_row"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/widget_compact_btn_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_widget_prev"
                android:contentDescription="Previous" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center">
            <ImageButton
                android:id="@+id/widget_compact_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_play_btn_bg"
                android:src="@drawable/ic_widget_play"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Play/Pause" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">
            <ImageButton
                android:id="@+id/widget_compact_btn_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_widget_next"
                android:contentDescription="Next" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
