<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed rounded album artwork with bottom gradient vignette -->
    <ImageView
        android:id="@+id/widget_full_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Album Artwork Background" />

    <!-- RelativeLayout ensures top-right Favorite and bottom Metadata+Controls never overlap or clip on compact 2x2 grids -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_full_btn_favorite"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:scaleType="centerInside"
            android:contentDescription="Favorite Track" />

        <LinearLayout
            android:id="@+id/widget_full_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_full_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OffGrid Music"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_full_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Offline Audio"
                android:textColor="#DDE2EC"
                android:textSize="11sp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="6dp">

                <ImageView
                    android:id="@+id/widget_full_btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_full_btn_play_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_full_btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Next Track" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
