<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed rounded album artwork with bottom gradient vignette -->
    <ImageView
        android:id="@+id/widget_full_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Album Artwork Background" />

    <!-- Foreground layout separating top-right Favorite button and bottom metadata + controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: Favorite Heart button anchored top-right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|top">

            <ImageView
                android:id="@+id/widget_full_btn_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Favorite Track" />
        </LinearLayout>

        <!-- Flexible middle space so artwork breathes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom metadata and transport controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_full_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OffGrid Music"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_full_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Offline Audio"
                android:textColor="#D0D4DC"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/widget_full_btn_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_full_btn_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_full_btn_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Next Track" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
