<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-bleed rounded album artwork with bottom gradient vignette -->
    <ImageView
        android:id="@+id/widget_full_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Album Artwork Background" />

    <!-- Top-right Favorite Heart button -->
    <ImageView
        android:id="@+id/widget_full_btn_favorite"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerInside"
        android:contentDescription="Favorite Track" />

    <!-- Bottom content overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/widget_full_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OffGrid Music"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_full_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Offline Audio"
            android:textColor="#D0D4DC"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Straight horizontal progress bar with thumb dot -->
        <ImageView
            android:id="@+id/widget_full_progress"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY"
            android:contentDescription="Playback Progress" />

        <!-- Timestamps row (left current / right total) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/widget_full_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#C4C8D0"
                android:textSize="10sp"
                android:gravity="start"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_full_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#C4C8D0"
                android:textSize="10sp"
                android:gravity="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Playback Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_full_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerInside"
                android:contentDescription="Previous Track" />

            <ImageView
                android:id="@+id/widget_full_btn_play_pause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:scaleType="centerInside"
                android:contentDescription="Play or Pause" />

            <ImageView
                android:id="@+id/widget_full_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerInside"
                android:contentDescription="Next Track" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
