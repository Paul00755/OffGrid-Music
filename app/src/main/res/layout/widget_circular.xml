<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_circular_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <!-- Rendered Disc Canvas with Circular Progress Ring & Blurred Art Backdrop -->
    <ImageView
        android:id="@+id/widget_circular_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Circular Music Player" />

    <!-- Bottom Controls Overlay inside circle -->
    <LinearLayout
        android:id="@+id/widget_circular_controls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_circular_btn_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_circular_btn_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_play_btn_bg"
            android:src="@drawable/ic_widget_play"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_circular_btn_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next" />
    </LinearLayout>

    <!-- Center Track Info & Timestamps - ONLY Song Title and Album Name right below it -->
    <LinearLayout
        android:id="@+id/widget_circular_info_block"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_circular_controls"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_circular_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_circular_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Album"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="3dp" />

        <!-- Timestamps Row with Seek Targets -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/widget_circular_time_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" / "
                android:textColor="#66FFFFFF"
                android:textSize="10sp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <TextView
                android:id="@+id/widget_circular_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="0:00"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
