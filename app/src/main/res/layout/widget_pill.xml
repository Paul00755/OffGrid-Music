<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamically rendered stadium capsule background -->
    <ImageView
        android:id="@+id/widget_pill_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Content layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- Prominent Circular Play/Pause Button on Left -->
        <ImageView
            android:id="@+id/widget_pill_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:contentDescription="Play or Pause" />

        <!-- Artwork on Right with overlaid timestamp at bottom -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp">

            <!-- Rounded right-end artwork -->
            <ImageView
                android:id="@+id/widget_pill_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="Album Artwork" />

            <!-- Duration pill indicator at bottom-center -->
            <TextView
                android:id="@+id/widget_pill_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="2dp"
                android:text="0:00 / 0:00"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
