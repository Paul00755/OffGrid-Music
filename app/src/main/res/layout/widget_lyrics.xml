<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Adaptive Black / Light themed rounded card background -->
    <ImageView
        android:id="@+id/widget_lyrics_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Lyrics Widget Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header Row: Artwork + Song Info + Mini Transport Controls -->
        <LinearLayout
            android:id="@+id/widget_lyrics_header_click"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_lyrics_artwork"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="fitCenter"
                android:contentDescription="Album Artwork" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/widget_lyrics_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OffGrid Music"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Live Lyrics"
                    android:textColor="#8E96A8"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Compact Header Controls: Favorite, Prev, Play/Pause, Next -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_lyrics_btn_favorite"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Favorite Track" />

                <ImageView
                    android:id="@+id/widget_lyrics_btn_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_lyrics_btn_play_pause"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_lyrics_btn_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Next Track" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Smooth-Transition Lyrics Stage (ViewFlipper with dual lyric buffers) -->
        <ViewFlipper
            android:id="@+id/widget_lyrics_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:inAnimation="@anim/widget_lyric_slide_in"
            android:outAnimation="@anim/widget_lyric_slide_out">

            <!-- Buffer Page 0 -->
            <LinearLayout
                android:id="@+id/widget_lyrics_page_0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_lyrics_prev2_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#5A6275"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_lyrics_prev_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7D8597"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_curr_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="♪ Play a song to view live synced lyrics"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_next_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7D8597"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_next2_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#5A6275"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_lyrics_next3_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#43495A"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Buffer Page 1 -->
            <LinearLayout
                android:id="@+id/widget_lyrics_page_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/widget_lyrics_prev2_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#5A6275"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_lyrics_prev_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7D8597"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_curr_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="3dp"
                    android:text="♪ Play a song to view live synced lyrics"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_next_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#7D8597"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_lyrics_next2_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#5A6275"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_lyrics_next3_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#43495A"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>
        </ViewFlipper>

        <!-- Bottom Progress + Timestamps Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_lyrics_time_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8D95A5"
                android:textSize="9.5sp"
                android:includeFontPadding="false" />

            <ImageView
                android:id="@+id/widget_lyrics_progress"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="Playback Progress" />

            <TextView
                android:id="@+id/widget_lyrics_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8D95A5"
                android:textSize="9.5sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
