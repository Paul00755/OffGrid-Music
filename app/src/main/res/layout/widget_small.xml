<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dark themed rounded card background -->
    <ImageView
        android:id="@+id/widget_small_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Top row: Inset square artwork on left + Favorite button on top-right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="top">

            <ImageView
                android:id="@+id/widget_small_artwork"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:contentDescription="Album Artwork" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_small_btn_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerInside"
                android:contentDescription="Favorite Track" />
        </LinearLayout>

        <!-- Song Title -->
        <TextView
            android:id="@+id/widget_small_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OffGrid Music"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Artist Subtitle -->
        <TextView
            android:id="@+id/widget_small_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Offline Audio"
            android:textColor="#9AA2B1"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Straight horizontal progress bar with thumb dot -->
        <ImageView
            android:id="@+id/widget_small_progress"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitXY"
            android:contentDescription="Playback Progress" />

        <!-- Timestamps row (left current / right total) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_small_time_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#8D95A5"
                android:textSize="10sp"
                android:gravity="start"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_small_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#8D95A5"
                android:textSize="10sp"
                android:gravity="end"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Bottom Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/widget_small_btn_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Previous Track" />

            <ImageView
                android:id="@+id/widget_small_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerInside"
                android:contentDescription="Play or Pause" />

            <ImageView
                android:id="@+id/widget_small_btn_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Next Track" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
