<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dark themed rounded card background -->
    <ImageView
        android:id="@+id/widget_small_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- RelativeLayout guarantees bottom transport controls are never clipped off on compact 2x2 grids -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <!-- Top row: Inset rounded-square artwork on left + Favorite button on top-right -->
        <RelativeLayout
            android:id="@+id/widget_small_top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/widget_small_artwork"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"
                android:contentDescription="Album Artwork" />

            <ImageView
                android:id="@+id/widget_small_btn_favorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:scaleType="centerInside"
                android:contentDescription="Favorite Track" />
        </RelativeLayout>

        <!-- Bottom metadata + controls anchored cleanly inside bottom edge -->
        <LinearLayout
            android:id="@+id/widget_small_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- Song Title -->
            <TextView
                android:id="@+id/widget_small_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OffGrid Music"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- Artist Subtitle -->
            <TextView
                android:id="@+id/widget_small_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Offline Audio"
                android:textColor="#9AA2B1"
                android:textSize="10.5sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <!-- Bottom Playback Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/widget_small_btn_prev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_small_btn_play_pause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_small_btn_next"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Next Track" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
