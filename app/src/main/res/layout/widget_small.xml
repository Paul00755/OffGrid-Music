<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dark themed rounded card background -->
    <ImageView
        android:id="@+id/widget_small_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <!-- Top row: Inset rounded-square artwork on left + Favorite button on top-right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <ImageView
                android:id="@+id/widget_small_artwork"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="fitCenter"
                android:contentDescription="Album Artwork" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_small_btn_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Favorite Track" />
        </LinearLayout>

        <!-- Flexible spacer so content adapts cleanly across launcher grid heights without crushing artwork -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Song Title -->
        <TextView
            android:id="@+id/widget_small_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OffGrid Music"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Artist Subtitle -->
        <TextView
            android:id="@+id/widget_small_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Offline Audio"
            android:textColor="#9AA2B1"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <!-- Bottom Playback Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_small_btn_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Previous Track" />

            <ImageView
                android:id="@+id/widget_small_btn_play_pause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerInside"
                android:contentDescription="Play or Pause" />

            <ImageView
                android:id="@+id/widget_small_btn_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:contentDescription="Next Track" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
