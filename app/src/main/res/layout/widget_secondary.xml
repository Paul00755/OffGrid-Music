<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_secondary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dark themed rounded card background -->
    <ImageView
        android:id="@+id/widget_secondary_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left full-height bleed artwork (rounded on top-left and bottom-left corners, flush on right) -->
        <ImageView
            android:id="@+id/widget_secondary_artwork"
            android:layout_width="124dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="Album Artwork" />

        <!-- Right column: Metadata + Favorite, Glowing Waveform Progress Bar, Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- Top Row: Title/Artist + Favorite Heart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_secondary_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="OffGrid Music"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/widget_secondary_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Offline Audio"
                        android:textColor="#9AA2B1"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_secondary_btn_favorite"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Favorite Track" />
            </LinearLayout>

            <!-- Glowing Sine-Wave / Squiggly Waveform Progress Bar with Glowing Orb Thumb -->
            <ImageView
                android:id="@+id/widget_secondary_progress"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:scaleType="fitXY"
                android:contentDescription="Waveform Playback Progress" />

            <!-- Timestamps row (left current / right total) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_secondary_time_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#8D95A5"
                    android:textSize="10sp"
                    android:gravity="start"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/widget_secondary_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#8D95A5"
                    android:textSize="10sp"
                    android:gravity="end"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Bottom Playback Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <ImageView
                    android:id="@+id/widget_secondary_btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous Track" />

                <ImageView
                    android:id="@+id/widget_secondary_btn_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Play or Pause" />

                <ImageView
                    android:id="@+id/widget_secondary_btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Next Track" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
