<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamically rendered dark harmonized rounded card background -->
    <ImageView
        android:id="@+id/widget_wide_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Widget Background" />

    <!-- Content horizontal split row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left Column: Controls & Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top-left Favorite / Music Action Button -->
            <ImageView
                android:id="@+id/widget_wide_btn_favorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="start"
                android:layout_marginStart="2dp"
                android:scaleType="centerInside"
                android:contentDescription="Toggle Favorite" />

            <!-- Centered Song Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="4dp">

                <!-- Song Title -->
                <TextView
                    android:id="@+id/widget_wide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OffGrid Music"
                    android:textColor="#FF4B72"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <!-- Subtitle (Artist • Album) -->
                <TextView
                    android:id="@+id/widget_wide_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Offline Audio"
                    android:textColor="#B8A2AC"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <!-- Timestamp (3:04 / 4:56) -->
                <TextView
                    android:id="@+id/widget_wide_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0:00 / 0:00"
                    android:textColor="#E8D0D8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Bottom Circular Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="2dp">

                <!-- Previous Button -->
                <ImageView
                    android:id="@+id/widget_wide_btn_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Previous Track" />

                <!-- Play / Pause Button -->
                <ImageView
                    android:id="@+id/widget_wide_btn_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Play or Pause" />

                <!-- Next Button -->
                <ImageView
                    android:id="@+id/widget_wide_btn_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerInside"
                    android:contentDescription="Next Track" />
            </LinearLayout>

        </LinearLayout>

        <!-- Right Side: Rounded Square Artwork -->
        <ImageView
            android:id="@+id/widget_wide_artwork"
            android:layout_width="125dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:contentDescription="Album Artwork" />

    </LinearLayout>

</FrameLayout>
