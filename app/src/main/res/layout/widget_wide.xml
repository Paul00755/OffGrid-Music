<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:padding="14dp">

    <!-- Blurred Artwork Background Overlay -->
    <ImageView
        android:id="@+id/widget_wide_background_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.35" />

    <!-- Content Row: Artwork, Title, Subtitle, Artist -->
    <LinearLayout
        android:id="@+id/widget_wide_content_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_wide_artwork"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Album Art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_wide_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Con Altura"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_wide_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ft. El Guincho"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/widget_wide_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROSALÍA"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar Row with Seek Targets -->
    <LinearLayout
        android:id="@+id/widget_wide_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_wide_content_row"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_wide_time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="1:32"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/widget_wide_progress_container"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <ProgressBar
                android:id="@+id/widget_wide_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:progressDrawable="@drawable/widget_progress_drawable"
                android:max="100"
                android:progress="0" />

            <ImageView
                android:id="@+id/widget_wide_waveform_progress"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:contentDescription="Waveform Seek Bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_wide_seek_backward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek Backward"
                    android:src="@android:color/transparent" />

                <ImageView
                    android:id="@+id/widget_wide_seek_forward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek Forward"
                    android:src="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/widget_wide_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="3:51"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Controls Row: Evenly distributed 5-button layout -->
    <LinearLayout
        android:id="@+id/widget_wide_controls_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/widget_wide_progress_row"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_wide_btn_shuffle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle"
            android:contentDescription="Shuffle" />

        <ImageButton
            android:id="@+id/widget_wide_btn_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_prev"
            android:contentDescription="Previous" />

        <ImageButton
            android:id="@+id/widget_wide_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_play_btn_bg"
            android:src="@drawable/ic_widget_play"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Play/Pause" />

        <ImageButton
            android:id="@+id/widget_wide_btn_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_next"
            android:contentDescription="Next" />

        <ImageButton
            android:id="@+id/widget_wide_btn_favorite"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_favorite_border"
            android:contentDescription="Favorite" />
    </LinearLayout>

</RelativeLayout>
